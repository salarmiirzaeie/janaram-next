# Copy to .env.local and fill in. NEVER commit real values.

# --- Core ---
MONGODB_URI=mongodb://localhost:27017/janaram-db
JWT_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GA_ID=
CRON_SECRET=change-me

# --- Push notifications (Firebase Admin) ---
# The whole service-account JSON on ONE line. Create a new key in Google Cloud
# Console > IAM > Service Accounts and never commit the downloaded file.
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Payments (Zarinpal) ---
ZARINPAL_MERCHANT_ID=
DEV_PAYMENT_CALLBACK_BASE=http://localhost:3000

# --- SMS / OTP ---
SMS_API_KEY_PRO=
SMS_MELIPAYAMAK_PATH=

# --- Object storage (S3-compatible, Liara) ---
LIARA_ENDPOINT=
LIARA_BUCKET_NAME=
LIARA_ACCESS_KEY=
LIARA_SECRET_KEY=

# --- AI chatbot ---
EXPO_PUBLIC_CHATBOT_KEY_NEW=

# --- Bale messenger bot ---
BALE_BOT_TOKEN=
